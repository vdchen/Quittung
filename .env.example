# ==============================================================================
# PROJECT & ENVIRONMENT SETTINGS
# ==============================================================================
PROJECT_NAME=quittung
# Options: development | production | testing
ENVIRONMENT=development
# Set to False in production to suppress SQLAlchemy query logging and debug info
DEBUG=False
APP_NAME="Quittung API Service"
API_V1_PREFIX=/api/v1

# ==============================================================================
# INFRASTRUCTURE / PORTS
# ==============================================================================
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# Internal URL for service-to-service communication (used inside Docker)
API_URL=http://api:8000/api/v1

# ==============================================================================
# SECURITY  ⚠️  ALL VALUES BELOW MUST BE CHANGED BEFORE PRODUCTION DEPLOYMENT
# ==============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# API key protecting REST endpoints (X-API-Key header)
API_KEY=CHANGE_ME_your_api_key_here

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON-formatted list of allowed CORS origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==============================================================================
# DATABASE: POSTGRESQL
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=quittung_db

# Host should be 'db' when running inside Docker Compose
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_postgres_password@db:5432/quittung_db

# ==============================================================================
# REDIS / CELERY
# ==============================================================================
# Host should be 'redis' when running inside Docker Compose
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_PREFIX=session:
REDIS_SESSION_EXPIRE_SECONDS=1800

# ==============================================================================
# EXTERNAL INTEGRATIONS  ⚠️  REQUIRED
# ==============================================================================
# Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=CHANGE_ME_your_google_api_key

# Telegram @BotFather token
TELEGRAM_BOT_TOKEN=CHANGE_ME_your_telegram_bot_token

# REQUIRED: A random secret passed to set_webhook(secret_token=...).
# Telegram will include this in every webhook request so we can verify origin.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ==============================================================================
# STORAGE
# ==============================================================================
# Directory for temporary file uploads (relative to /app in Docker)
UPLOAD_DIR=uploads
# Maximum allowed upload file size in megabytes
MAX_UPLOAD_SIZE_MB=10
# How many hours to keep processed files before the cleanup task deletes them
UPLOAD_CLEANUP_HOURS=24