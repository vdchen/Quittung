# ==============================================================================
# PROJECT & ENVIRONMENT SETTINGS
# ==============================================================================
PROJECT_NAME=quittung
ENVIRONMENT=dev # Options: dev, prod, local
DEBUG=True
APP_NAME="Quittung API Service"
API_V1_PREFIX=/api/v1

# ==============================================================================
# INFRASTRUCTURE / PORTS
# ==============================================================================
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# Internal URL for service-to-service communication
API_URL=http://api:8000/api/v1

# ==============================================================================
# SECURITY (STRICTLY CONFIDENTIAL)
# ==============================================================================
# Generate a secure key for production using: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here
API_KEY=your-api-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON formatted list of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==============================================================================
# DATABASE: POSTGRESQL
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=quittung_db

# Host should be 'db' when running inside Docker Compose
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ==============================================================================
# REDIS / CELERY
# ==============================================================================
# Host should be 'redis' when running inside Docker Compose
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_PREFIX=session:
REDIS_SESSION_EXPIRE_SECONDS=1800

# ==============================================================================
# EXTERNAL INTEGRATIONS (KEYS REQUIRED)
# ==============================================================================
# Get your key from Google AI Studio (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here